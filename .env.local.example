# Supabase project settings > API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional: used by server-only actions that need elevated access (never expose to the client)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional: translation API for the post-detail "번역 보기" button
TRANSLATE_API_KEY=

# Optional: news URL ingest agent (news-digest/publish-news.mjs)
NEWS_AUTHOR_ID=
PEXELS_API_KEY=

# Optional: Naver Search API, for the daily news-digest script (developers.naver.com)
NAVER_SEARCH_CLIENT_ID=
NAVER_SEARCH_CLIENT_SECRET=

# Optional: 업체 지도 — 카카오 로컬 API(주소 지오코딩 + 수집 스크립트), 서버 전용
KAKAO_REST_API_KEY=

# Optional: 업체 지도 — 구글 Maps JS SDK(브라우저 표시), 공개 키
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

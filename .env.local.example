# Supabase project settings > API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional: used by server-only actions that need elevated access (never expose to the client)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional: translation API for the post-detail "번역 보기" button
TRANSLATE_API_KEY=

# Optional: Naver Search API, for the daily news-digest script (developers.naver.com)
NAVER_SEARCH_CLIENT_ID=
NAVER_SEARCH_CLIENT_SECRET=
